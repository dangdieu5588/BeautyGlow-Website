    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU Ubuntu WSL (%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "beautyglow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{project=\"beautyglow-website\",job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU sử dụng",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
