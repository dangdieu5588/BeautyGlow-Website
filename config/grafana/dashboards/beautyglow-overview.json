{
  "id": null,
  "uid": "beautyglow-overview",
  "title": "BeautyGlow — Tổng quan hệ thống",
  "description": "Giám sát Ubuntu WSL, bốn container website, Nginx, MySQL và HTTP. UP không tương đương Docker healthy.",
  "tags": [
    "beautyglow",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "01 · Trạng thái thu thập và HTTP",
      "collapsed": false,
