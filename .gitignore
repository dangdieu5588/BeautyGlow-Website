# Credentials and local environment (keep the sanitized template).
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
.secrets/
secrets/**
!secrets/.gitkeep
*.key
*.pem
*.p12
*.pfx
*.crt
*.cnf
*.credentials
.my.cnf
.npmrc
.netrc
.docker/

# Runtime data, media, database dumps and backups.
data/**
!data/.gitkeep
backups/**
!backups/.gitkeep
*.sql
*.sql.*
*.dump
*.sqlite*
*.db
*.ibd
*.ibdata*
*.vhdx
*.tar
*.tar.*
*.zip
*.bak
*.backup
wordpress/uploads/

# Evidence may contain secrets; publish only manually redacted files in public/.
evidence/**
!evidence/.gitkeep
!evidence/public/
!evidence/public/**
*.log

# Local tools and generated files.
.idea/
.vscode/
node_modules/
vendor/
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
tmp/
